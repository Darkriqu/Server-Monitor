[Unit]
Description=Server Monitor agent and dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=server-monitor
Group=server-monitor
EnvironmentFile=-/etc/server-monitor/env
ExecStart=/usr/local/bin/server-monitor --config /etc/server-monitor/config.toml
WorkingDirectory=/var/lib/server-monitor
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/server-monitor
Restart=on-failure
RestartSec=2s
LimitNOFILE=8192

[Install]
WantedBy=multi-user.target
